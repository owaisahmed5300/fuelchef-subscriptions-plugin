#!/bin/bash
set -e

if [ "$CI" = "true" ]; then
  exit 0
fi

# Diff against the upstream branch when there is one. `HEAD~1` is not a fallback: it
# does not exist in a repository with a single commit, which is exactly the state
# `git init && git commit --allow-empty` leaves you in.
if upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
  base="$upstream"
elif [ "$(git rev-list --count HEAD)" -gt 1 ]; then
  base="HEAD~1"
else
  # The empty tree: everything in the repository counts as changed.
  base="$(git hash-object -t tree /dev/null)"
fi

if ! git diff --name-only --diff-filter=d "$base" -- '*.php' | grep -q .; then
  echo "No PHP files changed. Skipping pre-push checks."
  exit 0
fi

echo
echo "========== Pre-push checks =========="
echo

./scripts/dev phpcs
./scripts/dev phpstan

# The pre-flight files are verified under PHP 5.6 (the oldest interpreter CI can
# still install; the files themselves stay written for PHP 5.3). Only run the
# check when one of those two files changed, to avoid pulling php:5.6 on every push.
if git diff --name-only --diff-filter=ACMR "$base" -- \
    'plugin/fuelchef-subscriptions.php' 'plugin/src/Requirements.php' | grep -q .; then
  ./scripts/dev preflight
fi

echo
echo "========== All pre-push checks passed =========="

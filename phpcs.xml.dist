<?xml version="1.0" ?>
<ruleset name="FuelChef Subscriptions PHPCS">
    <description>FuelChef Subscriptions coding standards.</description>

    <rule ref="WPTechnix-PSR4" />
    <rule ref="WPTechnix-Strict" />

    <file>plugin</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/vendor-prefixed/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!--
        The pre-flight files (the main plugin file and the requirements gate)
        target PHP 5.3 - they run before the PHP-version check, so a single
        newer construct would fatal instead of showing the notice that explains
        why. See docs/architecture.md. CI verifies their syntax under PHP 5.6
        and their semantics under 5.3 via `composer lint:compat`; here PHPCS
        just exempts them from the sniffs that would force a language feature
        newer than 5.3 (scalar type hints, typed properties, strict_types,
        short array syntax, static closures). Every other rule - security,
        i18n, naming, spacing - still applies to them.
    -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure">
        <!-- The main file's container resolver must not be `static`:
             static closures are PHP 5.4+, and the pre-flight files target PHP 5.3. -->
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>
    <rule ref="Generic.PHP.RequireStrictTypes">
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax">
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator">
        <!-- The null coalesce operator (??) is PHP 7.0+, and the pre-flight files target
             PHP 5.3. -->
        <exclude-pattern>plugin/src/Requirements.php</exclude-pattern>
        <exclude-pattern>plugin/fuelchef-subscriptions.php</exclude-pattern>
    </rule>

    <!--
        The sniff expects a bare `$wpdb->prepare()` call and does not recognise
        `$this->wpdb->prepare()` (constructor-injected, so a test can supply a mocked
        `wpdb` - see docs/technical/data-layer.md). Every dynamic value in a repository
        query is still a genuine `%s`/`%d`/`%i` placeholder for `prepare()`.
    -->
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <exclude-pattern>plugin/src/Repositories/*</exclude-pattern>
    </rule>

    <!-- Entity and Timestamped declare their setters as returning `static`. PHP requires
         an implementation to match that exactly - narrowing it to `self`, even in a
         final class, is a fatal "declaration must be compatible" error, not a style
         choice. -->
    <rule ref="Universal.CodeAnalysis.StaticInFinalClass.ReturnType">
        <exclude-pattern>plugin/src/Entities/*</exclude-pattern>
    </rule>

    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg name="cache" value=".phpcs.cache" />
    <arg value="sp" />

    <config name="testVersion" value="8.0-" />

    <!-- Must match the `Text Domain:` header in the main plugin file. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="fuelchef-subscriptions" />
            </property>
        </properties>
    </rule>
</ruleset>
